{
  "url": "https://localhost:7029/mcp",
  "insecure": false,
  "timeout": 15,
  "token_env": "Mcp:Token",
  "expect": {
    "tools": [
      "GetServerInfo",
      "GenerateAlgoristHashFromWord",
      "ConvertTemperature"
    ],
    "server_name": "Algorist MCP Server",
    "server_version": "1.0.0"
  },
  "tests": [
    {
      "name": "GetServerInfo response without errors",
      "tool": "GetServerInfo",
      "arguments": {}
    },
    {
      "name": "GenerateAlgoristHashFromWord response without errors",
      "tool": "GenerateAlgoristHashFromWord",
      "arguments": {
        "palavra": "testword"
      }
    },
    {
      "name": "ConvertTemperature response without errors",
      "tool": "ConvertTemperature",
      "arguments": {
        "value": 100,
        "from": "C",
        "to": "K"
      }
    }
  ]
}
