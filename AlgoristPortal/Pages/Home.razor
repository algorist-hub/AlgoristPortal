@page "/"
@implements IAsyncDisposable
@using AlgoristPortal.Pages.Sections
@inject IJSRuntime JS

<PageTitle>Algorist - Engenharia de Software</PageTitle>

<header id="header" class="header d-flex align-items-center fixed-top">
	<div class="container-fluid container-xl position-relative d-flex align-items-center justify-content-between">
		<a href="#inicio" class="logo d-flex align-items-center me-auto me-lg-0">
			<img src="img/brand/logo.png?v=2" alt="">
		</a>
		<nav id="navmenu" class="navmenu">
			<ul>
				<li><a href="#inicio" class="active" @onclick="CloseMobileNavigation">Início<br></a></li>
				<li><a href="#sobre" @onclick="CloseMobileNavigation">Sobre</a></li>
				<li><a href="#servicos" @onclick="CloseMobileNavigation">Serviços</a></li>
				<li><a href="#contato" @onclick="CloseMobileNavigation">Contato</a></li>
			</ul>
			<button type="button" class="mobile-nav-toggle d-xl-none bi @(isMobileNavActive ? "bi-x" : "bi-list") btn p-0 border-0 bg-transparent" aria-label="Toggle navigation menu" aria-expanded="@(isMobileNavActive ? "true" : "false")" @onclick="ToggleMobileNavigation"></button>
		</nav>
	</div>
</header>

<main>
	<InicioSection />
	<SobreSection />
	<ServicosSection />
	<ContatoSection />
</main>

<footer id="footer" class="footer dark-background">
	<div class="footer-top">
		<div class="container">
			<div class="row gy-4">
				<div class="footer-about text-end copyright">
					<p class="logo"><img src="img/brand/logo.png?v=2" alt="">&copy; 2026</p>
					<code>62.005.013/0001-00</code>
				</div>
			</div>
		</div>
	</div>
</footer>

<a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

@code {
	private IJSObjectReference? jsModule;
	private bool isMobileNavActive;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/siteInterop.js");
			await jsModule.InvokeVoidAsync("initializePageInteractions");
			await jsModule.InvokeVoidAsync("initializePageAnimations");
		}
	}

	private async Task ToggleMobileNavigation()
	{
		isMobileNavActive = !isMobileNavActive;
		await SyncMobileNavigationClass();
	}

	private async Task CloseMobileNavigation()
	{
		if (!isMobileNavActive)
		{
			return;
		}

		isMobileNavActive = false;
		await SyncMobileNavigationClass();
	}

	private async Task SyncMobileNavigationClass()
	{
		if (jsModule is not null)
		{
			await jsModule.InvokeVoidAsync("setMobileNavigation", isMobileNavActive);
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (jsModule is not null)
		{
			await jsModule.InvokeVoidAsync("disposePageInteractions");
			await jsModule.DisposeAsync();
		}
	}
}
